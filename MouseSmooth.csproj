<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 LTS : Windows 10 (1607+) et Windows 11. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MouseSmooth</AssemblyName>
    <RootNamespace>MouseSmooth</RootNamespace>
    <Version>2.1.0</Version>
    <Product>MouseSmooth</Product>
    <Description>Lisseur de curseur anti-tremblement : moyenne glissante du mouvement de la main (systray)</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
